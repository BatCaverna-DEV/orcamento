{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend", "--", "--port", "5180", "--strictPort"],
      "port": 5180
    },
    {
      "name": "backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--watch", "--watch-path=backend", "backend/index.js"],
      "port": 3000
    }
  ]
}
